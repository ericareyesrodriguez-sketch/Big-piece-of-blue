<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Big Piece of Blue - A Children's Storybook</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Fredoka', cursive, sans-serif;
            background-color: #e0f2fe;
            user-select: none;
            -webkit-user-select: none;
        }
        .story-font {
            font-family: 'Fredoka', sans-serif;
        }
        .bounce-gentle {
            animation: bounceGentle 3s infinite ease-in-out;
        }
        @keyframes bounceGentle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .pulse-slow {
            animation: pulseSlow 4s infinite ease-in-out;
        }
        @keyframes pulseSlow {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }
        .float-cloud {
            animation: floatCloud 6s infinite ease-in-out;
        }
        @keyframes floatCloud {
            0%, 100% { transform: translateX(0px); }
            50% { transform: translateX(15px); }
        }
        .page-transition {
            transition: opacity 0.4s ease-in-out, transform 0.4s ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between items-center p-3 sm:p-6 overflow-x-hidden text-slate-800">

    <!-- Header Navigation -->
    <header class="w-full max-w-4xl flex justify-between items-center bg-white/80 backdrop-blur-md px-4 py-3 rounded-2xl shadow-sm mb-4 border border-blue-100">
        <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-full bg-sky-400 flex items-center justify-center text-white font-bold text-lg">
                💙
            </div>
            <h1 class="text-lg sm:text-xl font-bold text-sky-800 tracking-wide">The Big Piece of Blue</h1>
        </div>
        
        <div class="flex items-center space-x-2">
            <button id="readAloudBtn" onclick="toggleReadAloud()" class="flex items-center space-x-2 bg-amber-400 hover:bg-amber-500 text-amber-950 px-3 py-1.5 rounded-xl font-semibold text-sm transition shadow-sm active:scale-95">
                <span id="speakerIcon">🔊</span>
                <span id="readBtnText" class="hidden sm:inline">Read to Me</span>
            </button>
            <button onclick="toggleGridMode()" class="bg-sky-100 hover:bg-sky-200 text-sky-700 px-3 py-1.5 rounded-xl font-semibold text-sm transition">
                📜 All Pages
            </button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="w-full max-w-4xl flex-1 flex flex-col items-center justify-center my-auto">
        
        <!-- Storybook View -->
        <div id="storybookCard" class="w-full bg-white rounded-3xl shadow-xl border-4 border-sky-200 p-4 sm:p-8 flex flex-col items-center relative overflow-hidden transition-all duration-300">
            
            <!-- Page Number & Audio Indicator -->
            <div class="w-full flex justify-between items-center mb-2 px-2 text-sky-500 font-semibold text-sm">
                <span id="pageIndicator">Page 1 of 9</span>
                <span id="readingStatus" class="hidden text-amber-600 animate-pulse text-xs font-bold">✨ Reading aloud...</span>
            </div>

            <!-- Visual Canvas / Illustration Area -->
            <div id="illustrationContainer" class="w-full h-64 sm:h-80 md:h-96 rounded-2xl bg-gradient-to-b from-sky-100 to-indigo-50 border-2 border-sky-100 flex items-center justify-center relative overflow-hidden my-2 shadow-inner">
                <!-- SVG Illustration dynamically rendered here -->
            </div>

            <!-- Story Text -->
            <div class="w-full min-h-[100px] flex items-center justify-center my-4 px-2 sm:px-6 text-center">
                <p id="storyText" class="story-font text-2xl sm:text-3xl md:text-4xl text-sky-900 font-bold leading-relaxed tracking-wide">
                    <!-- Text rendered here -->
                </p>
            </div>

            <!-- Page Controls -->
            <div class="w-full flex items-center justify-between pt-4 border-t border-sky-100">
                <button id="prevBtn" onclick="changePage(-1)" class="flex items-center space-x-2 bg-sky-100 hover:bg-sky-200 text-sky-800 font-bold px-5 py-3 rounded-2xl disabled:opacity-30 disabled:cursor-not-allowed transition active:scale-95 text-lg">
                    <span>👈</span>
                    <span>Back</span>
                </button>

                <!-- Page Dots -->
                <div id="dotsContainer" class="flex space-x-2">
                    <!-- Dots generated here -->
                </div>

                <button id="nextBtn" onclick="changePage(1)" class="flex items-center space-x-2 bg-sky-500 hover:bg-sky-600 text-white font-bold px-6 py-3 rounded-2xl disabled:opacity-30 disabled:cursor-not-allowed transition shadow-md active:scale-95 text-lg">
                    <span>Next</span>
                    <span>👉</span>
                </button>
            </div>
        </div>

        <!-- All Pages Grid View (Hidden by default) -->
        <div id="gridCard" class="hidden w-full bg-white rounded-3xl shadow-xl border-4 border-sky-200 p-4 sm:p-8">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-sky-800">Story Overview</h2>
                <button onclick="toggleGridMode()" class="bg-sky-500 text-white font-bold px-4 py-2 rounded-xl text-sm hover:bg-sky-600">
                    Close
                </button>
            </div>
            <div id="gridContainer" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Pages mapped here -->
            </div>
        </div>

    </main>

