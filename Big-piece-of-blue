        let speechSynthesisUtterance = null;

        // Initialize state
        window.onload = function() {
            renderDots();
            showPage(0);
        };

        function renderDots() {
            const container = document.getElementById('dotsContainer');
            container.innerHTML = '';
            pages.forEach((_, idx) => {
                const dot = document.createElement('button');
                dot.className = `w-3 h-3 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-sky-500 w-6' : 'bg-sky-200 hover:bg-sky-300'}`;
                dot.onclick = () => goToPage(idx);
                container.appendChild(dot);
            });
        }

        function updateDots() {
            const dots = document.getElementById('dotsContainer').children;
            Array.from(dots).forEach((dot, idx) => {
                if (idx === currentPageIndex) {
                    dot.className = 'w-6 h-3 rounded-full bg-sky-500 transition-all duration-300';
                } else {
                    dot.className = 'w-3 h-3 rounded-full bg-sky-200 hover:bg-sky-300 transition-all duration-300';
                }
            });
        }

        function showPage(index) {
            if (index < 0 || index >= pages.length) return;
            
            // Stop speech if active
            stopReadAloud();

            currentPageIndex = index;
            const page = pages[currentPageIndex];

            // Play gentle page turn chime
            playPageTurnSound();

            // Update UI
            const container = document.getElementById('illustrationContainer');
            const storyText = document.getElementById('storyText');
            
            container.style.opacity = '0';
            storyText.style.opacity = '0';

            setTimeout(() => {
                container.innerHTML = page.svg;
                storyText.innerText = page.text;
                container.style.opacity = '1';
                storyText.style.opacity = '1';
            }, 150);

            document.getElementById('pageIndicator').innerText = `Page ${page.page} of ${pages.length}`;
            document.getElementById('prevBtn').disabled = currentPageIndex === 0;
            
            const nextBtn = document.getElementById('nextBtn');
            if (currentPageIndex === pages.length - 1) {
                nextBtn.innerHTML = '<span>Start Over</span> <span>🔄</span>';
            } else {
                nextBtn.innerHTML = '<span>Next</span> <span>👉</span>';
            }

            updateDots();
        }

        function changePage(delta) {
            if (currentPageIndex + delta >= pages.length) {
                goToPage(0); // Loop back
            } else {
                showPage(currentPageIndex + delta);
            }
        }

        function goToPage(index) {
            showPage(index);
        }

        function toggleGridMode() {
            const storyCard = document.getElementById('storybookCard');
            const gridCard = document.getElementById('gridCard');

            if (gridCard.classList.contains('hidden')) {
                // Populate grid
                const container = document.getElementById('gridContainer');
                container.innerHTML = pages.map((p, idx) => `
                    <div onclick="selectFromGrid(${idx})" class="p-4 bg-sky-50 rounded-2xl border-2 border-sky-100 hover:border-sky-400 cursor-pointer transition shadow-sm hover:shadow-md">
                        <div class="h-44 rounded-xl overflow-hidden bg-white mb-3">
                            ${p.svg}
                        </div>
                        <p class="text-xs font-bold text-sky-500 mb-1">Page ${p.page}</p>
                        <p class="story-font text-sky-900 font-bold text-sm leading-snug">${p.text}</p>
                    </div>
                `).join('');

                storyCard.classList.add('hidden');
                gridCard.classList.remove('hidden');
            } else {
                gridCard.classList.add('hidden');
                storyCard.classList.remove('hidden');
            }
        }

        function selectFromGrid(index) {
            toggleGridMode();
            showPage(index);
        }

        // Web Audio Chime Sound
        function playPageTurnSound() {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                const ctx = new AudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(523.25, ctx.currentTime); // C5
                osc.frequency.exponentialRampToValueAtTime(659.25, ctx.currentTime + 0.15); // E5

                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start();
                osc.stop(ctx.currentTime + 0.2);
            } catch (e) {
                // Audio context may be muted or blocked before user interaction
            }
        }

        // Read Aloud Logic (Using Gemini TTS or Web Speech API fallback)
        async function toggleReadAloud() {
            if (isReading) {
                stopReadAloud();
            } else {
                startReadAloud();
            }
        }

        async function startReadAloud() {
            const currentText = pages[currentPageIndex].text;
            isReading = true;
            updateSpeechUI(true);

            // Attempt Gemini API Speech if network permits, else Web Speech API
            try {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    speechSynthesisUtterance = new SpeechSynthesisUtterance(currentText);
                    speechSynthesisUtterance.rate = 0.85; // Slower for toddlers
                    speechSynthesisUtterance.pitch = 1.1; // Warm/Friendly pitch

                    speechSynthesisUtterance.onend = function() {
                        stopReadAloud();
                    };
                    speechSynthesisUtterance.onerror = function() {
                        stopReadAloud();
                    };

                    window.speechSynthesis.speak(speechSynthesisUtterance);
                } else {
                    stopReadAloud();
                }
            } catch (err) {
                stopReadAloud();
            }
        }

        function stopReadAloud() {
            isReading = false;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
            }
            updateSpeechUI(false);
        }

        function updateSpeechUI(active) {
            const status = document.getElementById('readingStatus');
            const btnText = document.getElementById('readBtnText');
            const icon = document.getElementById('speakerIcon');

            if (active) {
                status.classList.remove('hidden');
                btnText.innerText = 'Stop';
                icon.innerText = '🔊';
            } else {
                status.classList.add('hidden');
                btnText.innerText = 'Read to Me';
                icon.innerText = '📢';
            }
        }
    </script>
</body>
</html>
